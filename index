<script>
'use strict';
const BOOK_DATA=[{"id":"01","day":"10月1日","title":"照顾自己，重生的起点","brief":"从放下手机、重新运动和静坐开始，先把身体与生活照顾好。","src":"images/01.jpg","thumb":"images/01_thumb.jpg","original":"images/01_original.png"},{"id":"02","day":"10月2日","title":"扑克复盘与心念回正","brief":"回看牌局的失利与情绪，把觉察和复盘变成向前的力量。","src":"images/02.jpg","thumb":"images/02_thumb.jpg","original":"images/02_original.png"},{"id":"03","day":"10月3日","title":"从虚无感中回来","brief":"早睡恢复，重新阅读、写作，把注意力带回真实生活。","src":"images/03.jpg","thumb":"images/03_thumb.jpg","original":"images/03_original.png"},{"id":"04","day":"10月4日","title":"从坏牌中返回行动","brief":"面对失利，不被情绪牵走；复盘关键一手，立刻重新行动。","src":"images/04.jpg","thumb":"images/04_thumb.jpg","original":"images/04_original.png"},{"id":"05","day":"10月5日","title":"从坏牌走向更广阔的天空","brief":"通过静坐、站桩和阅读调整自己，让眼光重新回到更广阔的生活。","src":"images/05.jpg","thumb":"images/05_thumb.jpg","original":"images/05_original.png"},{"id":"06A","day":"10月6日 · 上篇","title":"从内耗中抽离，回到创作","brief":"察觉反复思考消耗精力，用一个可执行的小步骤重启创作。","src":"images/06.jpg","thumb":"images/06_thumb.jpg","original":"images/06_original.png"},{"id":"06B","day":"10月6日 · 下篇","title":"从纠结内耗到温柔回正","brief":"放下自责与过度要求，先做今天最重要的一件事。","src":"images/07.jpg","thumb":"images/07_thumb.jpg","original":"images/07_original.png"},{"id":"07","day":"10月7日","title":"水流花开：看清之后温柔地活","brief":"从阅读感悟回到当下，记录生活，也学会温柔地面对生活。","src":"images/08.jpg","thumb":"images/08_thumb.jpg","original":"images/08_original.png"},{"id":"08","day":"10月8日","title":"《大光明手印》：抓住人生主线","brief":"把禅坐、AI创作与数字道场的方向写下，减少分散。","src":"images/09.jpg","thumb":"images/09_thumb.jpg","original":"images/09_original.png"},{"id":"09","day":"10月9日","title":"GG扑克：好运也要冷静收住","brief":"记录海洋KO赛事的高光时刻，提醒自己赢钱之后也要保持沉着。","src":"images/10.jpg","thumb":"images/10_thumb.jpg","original":"images/10_original.png"},{"id":"10","day":"10月10日","title":"历史转折中的邓小平：担当与纠偏","brief":"阅读历史人物的担当与决断，再审视自己的长期方向。","src":"images/11.jpg","thumb":"images/11_thumb.jpg","original":"images/11_original.png"}];
